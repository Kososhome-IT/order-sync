// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

// Note that some adapters may set a maximum length for the String type by default, please ensure your strings are long
// enough when changing adapters.
// See https://www.prisma.io/docs/orm/reference/prisma-schema-reference#string for more information
datasource db {
 provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Session {
  id            String    @id
  shop          String
  state         String
  isOnline      Boolean   @default(false)
  scope         String?
  expires       DateTime?
  accessToken   String
  userId        BigInt?
  firstName     String?
  lastName      String?
  email         String?
  accountOwner  Boolean   @default(false)
  locale        String?
  collaborator  Boolean?  @default(false)
  emailVerified Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

model OrderSync {
  id                 Int      @id @default(autoincrement())
  netsuiteOrderId    String?  @unique
  shopifyOrderId     String?  @unique
  netsuiteCompanyId  String?
  originSystem       String   // SHOPIFY | NETSUITE
  lastSyncedFrom     String   // SHOPIFY | NETSUITE
  status             String   // PENDING | SUCCESS | FAILED | PARTIAL
  action             String   @default("CREATE")
  errorMessage       String?
  paymentCapturedAt  DateTime?
  shopifyOrderName   String?
  webhookPayload    Json?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  logs               OrderSyncLog[]
  paymentRetries     PaymentRetry[]
  paymentAttempts    PaymentAttempt[]
}

model OrderSyncLog {
  id              Int       @id @default(autoincrement())
  orderSyncId     Int
  orderSync       OrderSync @relation(fields: [orderSyncId], references: [id])
  sourceSystem    String
  direction       String
  eventType       String
  status          String
  message         String?
  rawPayload      Json?
  requestPayload  Json?
  responsePayload Json?
  errorPayload    Json?
  createdAt       DateTime @default(now())
}

model CompanyMapping {
  id                       String   @id @default(cuid())

  netsuiteCompanyId        String   @unique

  shopifyCompanyId         String
  shopifyCompanyName       String

  shopifyCompanyLocationId String

  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt
}

model PaymentSync {
  id                  String   @id @default(cuid())

  netsuiteOrderId     String
  shopifyOrderId      String

  authorizationId     String

  paymentReference    String?

  capturedAmount      Float

  status              String

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model PaymentRetry {
  id                  Int      @id @default(autoincrement())

  // Multiple payment parts can belong to one order.
  orderSyncId         Int
  orderSync           OrderSync @relation(fields: [orderSyncId], references: [id], onDelete: Restrict)

  // Stable identity of the NetSuite payment instruction / partial payment.
  paymentInstructionId String
  paymentKey           String   @unique
  sourceOrderSyncLogId Int      @unique

  // Order identifiers
  shopifyOrderId      String
  shopifyOrderName    String?
  netsuiteOrderId     String?
  shop                String?

  // Payment details
  amount              Decimal  @db.Decimal(12, 2)
  currency            String?

  // Retry control
  status              String   @default("PENDING")
  attemptCount        Int      @default(0)
  maxAttempts         Int      @default(2)
  nextRetryAt         DateTime?
  lastAttemptAt       DateTime?

  // Payment verification and duplicate protection
  idempotencyKey      String?
  paymentReference    String?
  outcomeUnknown      Boolean  @default(false)

  // Failure details
  lastError           String?
  lastErrorCode       String?

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([status, nextRetryAt])
  @@index([orderSyncId])
  @@index([shopifyOrderId])
  @@index([netsuiteOrderId])
}

model PaymentAttempt {
  id                   Int      @id @default(autoincrement())
  orderSyncId          Int
  orderSync            OrderSync @relation(fields: [orderSyncId], references: [id], onDelete: Restrict)
  paymentInstructionId String
  paymentKey           String   @unique
  status               String   @default("PROCESSING")
  idempotencyKey       String?
  paymentReference     String?
  outcomeUnknown       Boolean  @default(false)
  lastError            String?
  lastAttemptAt        DateTime?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([orderSyncId])
}

model PaymentRetryCursor {
  id                  Int      @id @default(autoincrement())
  scope               String   @unique @default("PAYMENT_CAPTURE")
  lastOrderSyncLogId  Int      @default(0)
  updatedAt           DateTime @updatedAt
}

model PaymentRetryRun {
  id                  Int      @id @default(autoincrement())
  status              String   @default("PROCESSING")
  schedulerJobName    String?
  dueCount            Int      @default(0)
  processedCount      Int      @default(0)
  errorMessage        String?
  results             Json?
  startedAt           DateTime @default(now())
  completedAt         DateTime?

  @@index([startedAt])
}
